# LookupKB edge reverse proxy.
#
# SITE_ADDRESS controls the served site:
#   - "http://localhost"  → plaintext on :80 for local dev (default)
#   - "example.com"       → automatic HTTPS via Let's Encrypt (set ACME_EMAIL)
#
# Only Caddy is published to the host; upstreams are resolved on the internal
# `edge` network by service name.

{
	admin off
	# For production auto-TLS, set a contact email for Let's Encrypt by
	# uncommenting the next line (ACME_EMAIL must be non-empty):
	# email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Baseline security headers (see docs/planning/06-security.md §4). The strict
	# per-page CSP (§3, nonce-based) is applied by the app/render layer in a later
	# ticket; these are the transport-level headers Caddy owns.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
		-Server
	}

	# Optional route overlays (e.g. the observability overlay mounts a /grafana
	# snippet here). Globs to nothing for the core stack.
	import /etc/caddy/conf.d/*.caddy

	# Liveness/readiness passthrough to the API.
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}

	# Public + app API.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Identity (Authentik) — only reachable when the `auth` profile is up.
	handle /auth/* {
		reverse_proxy authentik-server:9000
	}

	# App shell + everything else → the SvelteKit SPA.
	handle /app/* {
		reverse_proxy web:8080
	}
	handle {
		reverse_proxy web:8080
	}
}
